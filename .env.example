# --- Veritabanı / kuyruk (lokal docker-compose portları) ---
DATABASE_URL=postgres://pumar:pumar@localhost:5433/pumar
REDIS_URL=redis://localhost:6380

# --- Jira (self-hosted, eski sürüm) ---
JIRA_BASE_URL=https://jira.crudfab.com
JIRA_EMAIL=
JIRA_API_TOKEN=            # eski Jira Server ise PAT (Personal Access Token) veya kullanıcı+şifre

# --- GitLab (self-hosted) ---
GITLAB_BASE_URL=https://gitlab.crudfab.com
GITLAB_TOKEN=             # Personal/Project Access Token (api scope)

# --- Senkron ayarları ---
SYNC_FULL_INTERVAL_MIN=60
ISSUE_KEY_REGEX=[A-Z][A-Z0-9]+-\d+   # PROJ-123 yakalama deseni
